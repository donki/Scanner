<Window x:Class="SocScanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SocScanner.App.Services"
        Title="{loc:T AppTitle}"
        Width="1040" Height="760" MinWidth="780" MinHeight="580"
        Background="{DynamicResource PageBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <DockPanel Margin="12">

        <!-- ============================ Cabecera ============================ -->
        <!-- Solo iconos (constitucion 6.1); el nombre de cada uno va en el tooltip y en UI Automation. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="LogoImage" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{loc:T AppTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="GuideButton" Style="{StaticResource GhostIconButton}" Content="&#xE897;" ToolTip="{loc:T ActionGuide}" AutomationProperties.Name="{loc:T ActionGuide}" Click="OnGuide" />
                <Button x:Name="NewsButton" Style="{StaticResource GhostIconButton}" Content="&#xE734;" ToolTip="{loc:T ActionWhatsNew}" AutomationProperties.Name="{loc:T ActionWhatsNew}" Click="OnNews" />
                <Button x:Name="LanguageButton" Style="{StaticResource GhostIconButton}" Content="&#xE8C1;" ToolTip="{loc:T LanguageTooltip}" AutomationProperties.Name="{loc:T LanguageTooltip}" Click="OnLanguage" />
                <Button x:Name="AboutButton" Style="{StaticResource GhostIconButton}" Content="&#xE946;" ToolTip="{loc:T ActionAbout}" AutomationProperties.Name="{loc:T ActionAbout}" Click="OnAbout" />
            </StackPanel>
        </Grid>

        <!-- ============================ Mandos (fijos abajo) ============================ -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Button x:Name="ScanButton" Style="{StaticResource ScanButton}" Content="&#xE8FE;" ToolTip="{loc:T ActionScanTip}" AutomationProperties.Name="{loc:T ActionScan}" Click="OnScan" />
                    <TextBlock Text="{loc:T ScanKeyHint}" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="NoWrap" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource BigGhostDangerIconButton}" Content="&#xE711;" Margin="10,0,0,18"
                        ToolTip="{loc:T ActionCancelScan}" AutomationProperties.Name="{loc:T ActionCancelScan}" Click="OnCancel" Visibility="Collapsed" />
                <StackPanel x:Name="DocumentButtons" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,18" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Style="{StaticResource BigIconButton}" Content="&#xE74E;" ToolTip="{loc:T ActionSave}" AutomationProperties.Name="{loc:T ActionSave}" Click="OnSave" />
                    <Button x:Name="ClearButton" Style="{StaticResource BigGhostDangerIconButton}" Content="&#xE74D;" Margin="6,0,0,0" ToolTip="{loc:T ActionClear}" AutomationProperties.Name="{loc:T ActionClear}" Click="OnClear" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" FontWeight="SemiBold" AutomationProperties.AutomationId="StatusText" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource HintText}" AutomationProperties.AutomationId="DetailText" />
                    <ProgressBar x:Name="ScanProgress" Style="{StaticResource Progress}" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="ScanProgress" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ Ajustes (izquierda) ============================ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">

                    <!-- Dispositivo -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{loc:T DeviceTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="DeviceCombo" Style="{StaticResource Combo}" MinWidth="0" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{loc:T DeviceTitle}" SelectionChanged="OnDeviceChanged" />
                                <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource GhostIconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                                        ToolTip="{loc:T ActionRefreshDevices}" AutomationProperties.Name="{loc:T ActionRefreshDevices}" Click="OnRefreshDevices" />
                            </Grid>
                            <TextBlock x:Name="DeviceInfoText" Style="{StaticResource HintText}" Margin="0,6,0,0" AutomationProperties.AutomationId="DeviceInfoText" />
                            <StackPanel x:Name="SourcePanel" Orientation="Horizontal" Visibility="Collapsed">
                                <RadioButton x:Name="FlatbedRadio" Style="{StaticResource Radio}" Content="{loc:T SourceFlatbed}" GroupName="Source" Margin="0,8,16,0" Checked="OnSourceChecked" />
                                <RadioButton x:Name="FeederRadio" Style="{StaticResource Radio}" Content="{loc:T SourceFeeder}" GroupName="Source" Checked="OnSourceChecked" />
                            </StackPanel>
                            <StackPanel x:Name="CameraPanel" Visibility="Collapsed">
                                <TextBlock Text="{loc:T CameraResolution}" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CameraResCombo" Style="{StaticResource Combo}" MinWidth="0" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{loc:T CameraResolution}" SelectionChanged="OnCameraResChanged" />
                                <TextBlock Text="{loc:T CameraHint}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Calidad -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{loc:T QualityTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PresetCombo" Style="{StaticResource Combo}" MinWidth="0" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{loc:T QualityTitle}" SelectionChanged="OnPresetChanged" />
                                <Button x:Name="QualityButton" Grid.Column="1" Style="{StaticResource GhostIconButton}" Content="&#xE713;" Margin="6,0,0,0"
                                        ToolTip="{loc:T ActionQuality}" AutomationProperties.Name="{loc:T ActionQuality}" Click="OnQuality" />
                            </Grid>
                            <TextBlock x:Name="QualitySummaryText" Style="{StaticResource HintText}" Margin="0,6,0,0" AutomationProperties.AutomationId="QualitySummaryText" />
                        </StackPanel>
                    </Border>

                    <!-- Modo -->
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{loc:T ModeTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <UniformGrid Rows="1" Columns="2">
                                <RadioButton x:Name="SingleTile" Style="{StaticResource TargetTile}" GroupName="Mode" Checked="OnModeChecked" AutomationProperties.Name="{loc:T ModeSingle}">
                                    <StackPanel>
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource GlyphSingle}" />
                                        <TextBlock Text="{loc:T ModeSingle}" Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="BatchTile" Style="{StaticResource TargetTile}" GroupName="Mode" Margin="0" Checked="OnModeChecked" AutomationProperties.Name="{loc:T ModeBatch}">
                                    <StackPanel>
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource GlyphBatch}" />
                                        <TextBlock Text="{loc:T ModeBatch}" Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- Una a una -->
                            <StackPanel x:Name="SinglePanel" Margin="0,4,0,0">
                                <TextBlock Text="{loc:T ModeSingleHint}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                <TextBlock Text="{loc:T SingleFormatLabel}" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="SingleFormatCombo" Style="{StaticResource Combo}" MinWidth="140"
                                          AutomationProperties.Name="{loc:T SingleFormatLabel}" SelectionChanged="OnSingleFormatChanged" />
                            </StackPanel>

                            <!-- En serie -->
                            <StackPanel x:Name="BatchPanel" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock Text="{loc:T ModeBatchHint}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                <TextBlock Text="{loc:T BatchFolderLabel}" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BatchFolderBox" Style="{StaticResource Field}" IsReadOnly="True" AutomationProperties.Name="{loc:T BatchFolderLabel}" />
                                    <Button x:Name="BrowseBatchFolderButton" Grid.Column="1" Style="{StaticResource GhostIconButton}" Content="&#xE8DA;" Margin="4,0,0,0"
                                            ToolTip="{loc:T BrowseFolder}" AutomationProperties.Name="{loc:T BrowseFolder}" Click="OnBrowseBatchFolder" />
                                    <Button x:Name="OpenBatchFolderButton" Grid.Column="2" Style="{StaticResource GhostIconButton}" Content="&#xE838;"
                                            ToolTip="{loc:T OpenFolder}" AutomationProperties.Name="{loc:T OpenFolder}" Click="OnOpenBatchFolder" />
                                </Grid>
                                <TextBlock Text="{loc:T BatchFormatLabel}" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="BatchFormatCombo" Style="{StaticResource Combo}" MinWidth="140"
                                          AutomationProperties.Name="{loc:T BatchFormatLabel}" SelectionChanged="OnBatchFormatChanged" />
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:T BatchPrefixLabel}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="BatchPrefixBox" Style="{StaticResource Field}" AutomationProperties.Name="{loc:T BatchPrefixLabel}"
                                                 LostFocus="OnBatchFieldCommit" KeyDown="OnBatchFieldKey" TextChanged="OnBatchFieldTyping" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:T BatchSuffixLabel}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="BatchSuffixBox" Style="{StaticResource Field}" AutomationProperties.Name="{loc:T BatchSuffixLabel}"
                                                 LostFocus="OnBatchFieldCommit" KeyDown="OnBatchFieldKey" TextChanged="OnBatchFieldTyping" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:T BatchNumberLabel}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="BatchNumberBox" Style="{StaticResource Field}" AutomationProperties.Name="{loc:T BatchNumberLabel}"
                                                 LostFocus="OnBatchFieldCommit" KeyDown="OnBatchFieldKey" TextChanged="OnBatchFieldTyping" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:T BatchDigitsLabel}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="BatchDigitsCombo" Style="{StaticResource Combo}" MinWidth="0" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="{loc:T BatchDigitsLabel}" SelectionChanged="OnBatchDigitsChanged" />
                                    </StackPanel>
                                </Grid>
                                <Border Background="{DynamicResource SelectionSurface}" CornerRadius="8" Padding="10,8" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T BatchNextLabel}" Style="{StaticResource HintText}" />
                                        <TextBlock x:Name="BatchNextText" Style="{StaticResource BodyText}" FontWeight="SemiBold" AutomationProperties.AutomationId="BatchNextText" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ Vista previa (derecha) ============================ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Ultimo guardado -->
                <Border x:Name="LastCard" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:T LastTitle}" Style="{StaticResource HintText}" />
                            <TextBlock x:Name="LastNameText" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.AutomationId="LastNameText" />
                            <TextBlock x:Name="LastInfoText" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OpenFileButton" Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="{loc:T ActionOpenFile}" AutomationProperties.Name="{loc:T ActionOpenFile}" Click="OnOpenFile" />
                            <Button x:Name="ShowInFolderButton" Style="{StaticResource GhostIconButton}" Content="&#xE838;" ToolTip="{loc:T ActionShowInFolder}" AutomationProperties.Name="{loc:T ActionShowInFolder}" Click="OnShowInFolder" />
                            <Button x:Name="CopyFileButton" Style="{StaticResource GhostIconButton}" Content="&#xE8C8;" ToolTip="{loc:T ActionCopyFile}" AutomationProperties.Name="{loc:T ActionCopyFile}" Click="OnCopyFile" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                    <Border Style="{StaticResource PreviewSurface}">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.AutomationId="PreviewImage" />
                            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                <TextBlock Text="&#xE8FE;" FontFamily="{StaticResource IconFont}" FontSize="44" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyHintText" Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,12,0,0" AutomationProperties.AutomationId="EmptyHintText" />
                            </StackPanel>
                            <Border x:Name="LiveBadge" Background="{DynamicResource Danger}" CornerRadius="6" Padding="8,3" Margin="8"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                                <TextBlock Text="{loc:T LiveBadge}" Foreground="{DynamicResource OnPrimary}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <!-- Hojas del documento (una a una) -->
                <Border x:Name="PagesCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="PageList" Style="{StaticResource PageStrip}" ItemContainerStyle="{StaticResource PageThumb}"
                                 AutomationProperties.Name="{loc:T PagesTitle}" SelectionChanged="OnPageSelected" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RotateLeftButton" Style="{StaticResource GhostIconButton}" Content="&#xE7AD;" ToolTip="{loc:T ActionRotateLeft}" AutomationProperties.Name="{loc:T ActionRotateLeft}" Click="OnRotateLeft">
                                    <Button.LayoutTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </Button.LayoutTransform>
                                </Button>
                                <Button x:Name="RotateRightButton" Style="{StaticResource GhostIconButton}" Content="&#xE7AD;" ToolTip="{loc:T ActionRotateRight}" AutomationProperties.Name="{loc:T ActionRotateRight}" Click="OnRotateRight" />
                                <Button x:Name="DeletePageButton" Style="{StaticResource GhostDangerIconButton}" Content="&#xE74D;" ToolTip="{loc:T ActionDeletePage}" AutomationProperties.Name="{loc:T ActionDeletePage}" Click="OnDeletePage" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="MoveLeftButton" Style="{StaticResource GhostIconButton}" Content="&#xE76B;" ToolTip="{loc:T ActionMoveLeft}" AutomationProperties.Name="{loc:T ActionMoveLeft}" Click="OnMoveLeft" />
                                <Button x:Name="MoveRightButton" Style="{StaticResource GhostIconButton}" Content="&#xE76C;" ToolTip="{loc:T ActionMoveRight}" AutomationProperties.Name="{loc:T ActionMoveRight}" Click="OnMoveRight" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
